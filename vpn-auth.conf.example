# vpn-auth.conf -- example. Copy to vpn-auth.conf and edit,
# or pass an explicit path: ./vpn-auth.sh -c /path/to/conf
# Sourced as shell by vpn-auth.sh and deploy.sh.
# Any variable is optional; unset ones keep the script defaults.

VPN_SERVER="vpn.example.com"       # VPN server address
VPN_PROTOCOL="anyconnect"          # anyconnect | gp | pulse | f5 | fortinet
VPN_USER="user"                    # login
VPN_GROUP="MYGROUP"                # tunnel-group (form auth: password + SMS)

# Command that prints the password to stdout (first factor).
PASSWORD_CMD="pass vpn/password"

# Other openconnect options.
EXTRA_OPTS="--disable-ipv6 --useragent=AnyConnect"

# csd-wrapper (hostscan). Empty = auto-detect / download.
#CSD_WRAPPER=""

# Where to save the cookie locally (default: session next to the script).
#SESSION_FILE="$HOME/.openconnect/session"

# Router (used by -p push and by deploy.sh).
ROUTER="root@192.168.1.1"
#ROUTER_SESSION="/tmp/oc-vpn.session"
