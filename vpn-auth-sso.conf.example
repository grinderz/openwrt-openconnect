# vpn-auth-sso.conf -- example. Copy to vpn-auth-sso.conf and edit,
# or pass an explicit path: ./vpn-auth-sso.sh -c /path/to/conf
# Sourced as shell by vpn-auth-sso.sh.
# Any variable is optional; unset ones keep the script defaults.

VPN_SERVER="vpn.example.com"       # VPN server address
VPN_GROUP="MYGROUP-SSO"            # tunnel-group (SAML/SSO one)

# AnyConnect version openconnect-sso impersonates; the cookie is bound to
# the resulting User-Agent "AnyConnect Linux_64 <version>".
#AC_VERSION="4.7.00136"

# Extra openconnect-sso options.
#SSO_OPTS="-l DEBUG"

# csd-wrapper (hostscan). Empty = auto-detect / download.
#CSD_WRAPPER=""

# Where to save the cookie locally (default: session next to the script).
#SESSION_FILE="$HOME/.openconnect/session"

# Router (used by -p push).
ROUTER="root@192.168.1.1"
#ROUTER_SESSION="/tmp/oc-vpn.session"
